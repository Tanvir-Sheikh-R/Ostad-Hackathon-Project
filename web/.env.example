# ─────────────────────────────────────────────────────────────
# Local development (copy to .env.local)
#   cp .env.example .env.local
#
# The API runs on port 8000 next to the Next.js dev server on port 3000.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# ─────────────────────────────────────────────────────────────
# Production (Vercel) — do NOT put this here.
#
# Set it in the Vercel dashboard instead: Project → Settings → Environment
# Variables → NEXT_PUBLIC_API_BASE = https://api.your-domain (no trailing slash),
# for Production + Preview + Development, then redeploy. NEXT_PUBLIC_* values are
# inlined at build time, so changing them requires a new build.
#
# Leaving this file's value at http://127.0.0.1:8000 is harmless on Vercel: the
# dashboard variable wins, and a localhost API base is ignored on a deployed host.
# ─────────────────────────────────────────────────────────────
