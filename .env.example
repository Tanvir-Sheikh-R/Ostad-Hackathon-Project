# ─────────────────────────────────────────────────────────────
# পাঠ সমাধান — backend configuration
# Copy to .env and fill in the keys. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- LLM providers (at least one is required) ---
# Groq is tried first, DeepSeek second: a provider without a key is skipped.
LLM_PROVIDER_ORDER=groq,deepseek
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_MODEL=deepseek-chat

# --- server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- CORS (Vercel frontend) ---
# Production origin(s), comma-separated. Preview deployments are covered by the regex.
CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- deployment (deploy/docker-compose.aws.yml) ---
# DNS name pointed at the EC2 Elastic IP; Caddy gets a Let's Encrypt cert for it.
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
# Exactly the origin Vercel serves the UI from.
FRONTEND_ORIGIN=https://your-app.vercel.app

# --- optional overrides (defaults are correct for the container layout) ---
# CHAPTERS_INDEX=/app/chapters.json
# EMBEDDING_CACHE=/app/embedding_cache
# EMBEDDING_MODEL_DIR=/app/model_cache/e5-base
# DATA_DIR=/app/data
# DB_PATH=/app/data/study.db
# CATALOG_CLASSES=class_9_10
# HYBRID_K=5
# QUIZ_QUESTION_COUNT=5
# THREAD_RETENTION_DAYS=3
