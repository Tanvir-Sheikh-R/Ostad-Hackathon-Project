# ─────────────────────────────────────────────────────────────
# Boi Bondhu — backend configuration
# Copy to .env and fill in the keys. .env is git-ignored; never commit it.
#
#   local:      python -m backend.run          (or: docker compose up -d)
#   EC2:        deploy/docker-compose.aws.yml  (env file lives next to it)
# ─────────────────────────────────────────────────────────────

# --- LLM providers (at least one is required) ---
# Groq is tried first, DeepSeek second: a provider without a key is skipped.
LLM_PROVIDER_ORDER=groq,deepseek
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPSEEK_MODEL=deepseek-chat

# --- server ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# One worker holds one encoder (~1.1 GB); more workers only cost memory.
WEB_CONCURRENCY=1

# --- browser origins ---
# Only used when the browser calls the API DIRECTLY (direct mode / Caddy domain).
# In the deployed proxy mode the browser never talks to this host, so CORS is idle.
# Preview deployments are covered by the regex.
CORS_ORIGINS=https://boibondhu.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
FRONTEND_ORIGIN=https://boibondhu.vercel.app

# --- EC2 deployment (deploy/docker-compose.aws.yml) ---
# The image is built locally and pushed to Docker Hub; EC2 only pulls it.
BACKEND_IMAGE=tanvirsheikh/boibondhu-hackathon-backend:v1

# Only needed for the optional own-domain + TLS profile (--profile tls):
# API_DOMAIN=boibondhu.duckdns.org
# ACME_EMAIL=you@example.com

# --- optional overrides (defaults match the container layout) ---
# CHAPTERS_INDEX=/app/chapters.json
# CHAPTER_TITLES_EN=/app/chapter_titles_en.json
# EMBEDDING_CACHE=/app/embedding_cache
# EMBEDDING_MODEL_DIR=/app/model_cache/e5-base
# DATA_DIR=/app/data
# DB_PATH=/app/data/study.db
# CATALOG_CLASSES=class_9_10
# HYBRID_K=5
# QUIZ_QUESTION_COUNT=5
# THREAD_RETENTION_DAYS=3
